{
  "name": "the-binary-tree",
  "version": "0.1.0",
  "description": "3D hyperbolic tree browser for the history of computing. A three.js take on d3-hypertree.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "hyperbolic",
    "poincare-ball",
    "tree",
    "hierarchy",
    "visualization",
    "three",
    "webgl",
    "computer-history"
  ],
  "main": "./dist/the-binary-tree.umd.cjs",
  "module": "./dist/the-binary-tree.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/the-binary-tree.js",
      "require": "./dist/the-binary-tree.umd.cjs"
    },
    "./style.css": "./dist/the-binary-tree.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "predev": "tsx scripts/agents-status.ts",
    "dev": "vite",
    "build": "vite build",
    "prebuild:demo": "tsx scripts/agents-status.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit:wiki": "tsx scripts/audit-wiki.ts",
    "wiki:candidates": "tsx scripts/wiki-candidates.ts",
    "wiki:files": "tsx scripts/wiki-files.ts"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.185.4",
    "@typescript/typescript6": "^6.0.2",
    "three": "^0.185.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
